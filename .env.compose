# .env.compose — example environment for the local Docker Compose stack.
# Owned by KNOW-2263. The repo's main `.env.example` (KNOW-2258) covers
# non-Compose dev runs.
#
# Copy this file and edit if you need to tweak local values:
#   cp .env.compose .env.compose.local
#   docker compose --env-file .env.compose.local up -d
#
# IMPORTANT: never put real credentials here. Production secrets live in
# AWS Secrets Manager (plan section 6).

# ---- App identity --------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# ---- Web server ----------------------------------------------------------
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Compose-only: trust X-Forwarded-* from any client. There is no real
# proxy in front of the container locally, so this is harmless. PRODUCTION
# must override this (via App Runner env / Secrets Manager) with the real
# proxy CIDR — never "*".
FORWARDED_ALLOW_IPS=*

# ---- Database (points at the `postgres` compose service) ----------------
DATABASE_URL=postgresql+asyncpg://fme_train:fme_train@postgres:5432/fme_train

# ---- S3 / MinIO (points at the `minio` compose service) -----------------
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-west-2
S3_BUCKET_ARTIFACTS=fme-train-prod-artifacts
S3_BUCKET_DRAFTS=fme-train-prod-drafts
S3_BUCKET_SKILLJAR_CONTENT=fme-train-prod-skilljar-content
S3_BUCKET_CACHE=fme-train-prod-cache
S3_BUCKET_IMAGES=fme-train-prod-images

# ---- Auth (placeholders — replace locally if you wire up real Google SSO)
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
SESSION_SIGNING_KEY=dev-only-not-secret-change-me-please-1234567890

# ---- External APIs (must be set locally if running real pipeline) -------
# Leave blank in the committed file — set them in your shell or a local
# .env.compose.local that is gitignored.
OPENAI_API_KEY=
JIRA_API_BASE_URL=
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
SKILLJAR_API_KEY=

# ---- Run scheduler / cost guards (plan section 3) -----------------------
MAX_RUN_USD=20
RUN_CONCURRENCY=2

# ---- Pipeline artifact / content roots (KNOW-2334) ----------------------
# Where per-run artifacts (manifests, changelogs, reports) are written.
# In the container, /app/artifacts is a convenient writable path; map it
# to a host volume in docker-compose.yml if you want artifacts to persist
# across container restarts.
ARTIFACTS_ROOT=/app/artifacts
# Root of the versioned lesson content tree inside the container.
# The app container mounts the repo as /app, so lesson folders like
# 2025.0/ are at /app/2025.0/.
LESSON_CONTENT_ROOT=/app

# ---- Mailhog (only relevant under `--profile mail`) ---------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=fme-train@localhost
