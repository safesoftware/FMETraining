# .dockerignore — keep the build context lean and avoid leaking secrets.
# Owned by KNOW-2263 (Phase 0 Dockerfile + Compose stack).

# --- VCS / dev metadata ---------------------------------------------------
.git
.gitattributes
.github
.devcontainer
.vscode
.idea
.claude

# --- Secrets / env files (allow only .env.example and .env.compose) -------
.env
.env.*
!.env.example
!.env.compose
!.env.sample

# --- Python build / cache -------------------------------------------------
__pycache__
**/__pycache__
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info
*.egg
build
dist
.eggs
.venv
venv
env
ENV
.pytest_cache
.mypy_cache
.ruff_cache
.tox
.coverage
.coverage.*
htmlcov
.hypothesis

# --- Local-only data, artifacts, and inputs (read-only sources or runtime
#     state that must not bake into the image) -----------------------------
artifacts
data
inputs
# Local Docker writable runtime roots (KNOW-2354) — bind-mounted at runtime,
# must never bake into the image.
.local-cache
.local-drafts

# --- Lesson content trees -------------------------------------------------
# The version-folder corpus was removed from the repo in KNOW-2364 — content is
# now sourced at runtime from the public S3 mirror (CONTENT_SOURCE=s3mirror,
# pipeline/content_source.py). Nothing to ignore here anymore; a defensive glob
# keeps any stray local version folder out of the image.
20[0-9][0-9].[0-9]*/

# --- Tests / IaC owned by other tickets ----------------------------------
tests
infra

# --- Editor / OS junk -----------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- Docs / readmes (don't need them inside the runtime image) -----------
docs
*.md
!README.md

# --- Misc ----------------------------------------------------------------
*.log
*.sqlite3
*.sqlite3-journal
launcher.html
launch.sh
launch.bat
