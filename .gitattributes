# Normalize line endings
* text=auto

# Text files - always LF
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.claudeignore text eol=lf
*.sample text eol=lf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.PNG binary
*.pyc binary
