# .env template for the multi-user web app (KNOW-2257 / Phase 0).
#
# Copy to .env and fill in real values for local dev. NEVER commit .env.
# In staging / production these values are injected by the App Runner /
# Fargate task definitions from AWS Secrets Manager — boto3 is NOT in the
# hot path.
#
# Legacy launcher / pipeline vars (OPENAI_MODEL, JIRA_PROJECT_KEYS, etc.)
# still live in .env.sample for now while serve.py coexists with the new app.
# This file covers only what app/config.py reads.

# ---- App / runtime --------------------------------------------------------
ENVIRONMENT=local                  # local | staging | production
APP_VERSION=dev                    # CI overrides with the git SHA at build
LOG_LEVEL=INFO

# ---- Database -------------------------------------------------------------
# Optional in Phase 0; required once KNOW-2260 wires the engine.
DATABASE_URL=postgresql+psycopg://fme:fme@localhost:5432/fme_training

# ---- Sessions / Google OIDC (KNOW-2259) -----------------------------------
# Generate a session signing key locally with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_KEY=replace-me-with-random-48-byte-urlsafe-token
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Jira -----------------------------------------------------------------
JIRA_BASE_URL=https://safesoftware.atlassian.net
JIRA_USER=
JIRA_API_KEY=
JIRA_FILTER_ID=

# ---- Skilljar -------------------------------------------------------------
SKILLJAR_API_KEY=
SKILLJAR_DOMAIN=

# ---- AWS / S3 -------------------------------------------------------------
# Local dev usually uses access keys; production uses the task IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-west-2

# ---- Cost ceiling ---------------------------------------------------------
# Per-run dollar cap for OpenAI spend. Worker aborts before next call once
# projected total exceeds this. Configurable per env via SSM Parameter Store
# in production.
MAX_RUN_USD=50
