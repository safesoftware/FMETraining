{
  "name": "FME Training Automation",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=fme-training-claude-plugins,target=/home/vscode/.claude/plugins,type=volume"
  ],
  "postCreateCommand": "pip install -r requirements.txt && npm install -g @anthropic-ai/claude-code && ln -sf /home/vscode/.claude/.claude.json /home/vscode/.claude.json",
  "postStartCommand": "bash .devcontainer/fix-windows-paths.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Report server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "anthropic.claude-code"
      ]
    }
  }
}
