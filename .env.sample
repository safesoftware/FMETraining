# Required
OPENAI_API_KEY=your_openai_api_key_here

# Optional - OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional - Jira project keys to include (comma-separated, no spaces)
# Default: FOUNDATION,FMEENGINE,FMEFLOW,FMEFORM
JIRA_PROJECT_KEYS=FOUNDATION,FMEENGINE,FMEFLOW,FMEFORM
JIRA_BASE_URL=
JIRA_USER=
JIRA_API_KEY=
JIRA_FILTER_ID=

# Optional - Rate limiting for OpenAI API
OPENAI_MAX_CONCURRENT=5
OPENAI_RPM=60

# Optional - Include full lesson text in prompts (reduces false positives, ~3x input token cost)
INCLUDE_FULL_TEXT=false

# Optional - Future Jira API integration
# JIRA_BASE_URL=https://your-instance.atlassian.net
# JIRA_USER=your@email.com
# JIRA_API_TOKEN=your_jira_api_token_here

# Optional - Alt text enrichment model for --enrich-alt-text (default: gpt-4o)
ALT_TEXT_MODEL=gpt-4o
ALT_TEXT_MAX_CONCURRENT=5

# Optional - Vision-based screenshot verification in Step 6 (default: false)
# Sends each lesson image to a multimodal LLM to confirm/correct screenshot flags.
# Adds significant API cost (~1 call per image per lesson). Enable after running
# --enrich-alt-text to get the most benefit from both features together.
ENABLE_VISION_SCREENSHOT_REVIEW=false

# Optional - Skilljar integration (required for Push to Skilljar feature)
SKILLJAR_API_KEY=
# Optional - Skilljar domain slug (required for tag updates during Release)
# Find in your Skilljar dashboard URL: dashboard.skilljar.com/domain/<slug>/...
SKILLJAR_DOMAIN=

# Optional - AWS S3 (required for image upload during Release)
# Images are staged in S3 so Skilljar can fetch them, then deleted after upload.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1